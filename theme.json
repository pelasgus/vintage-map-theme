{
  "version": 8,
  "sources": {
    "ne2_shaded": {
      "maxzoom": 6,
      "tileSize": 256,
      "tiles": [
        "https://tiles.openfreemap.org/natural_earth/ne2sr/{z}/{x}/{y}.png"
      ],
      "type": "raster"
    },
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#ebd4a2"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["MultiPolygon", "Polygon"],
          true,
          false
        ],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "paint": {
        "fill-antialias": true,
        "fill-color": "#bcc7b7"
      }
    },
    {
      "id": "water_coastline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["MultiPolygon", "Polygon"],
          true,
          false
        ],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "paint": {
        "line-color": "#bcc7b7",
        "line-width": 0.8,
        "line-opacity": 0.7
      }
    },
    {
      "id": "landcover_ice_shelf",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "maxzoom": 8,
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["MultiPolygon", "Polygon"],
          true,
          false
        ],
        ["==", ["get", "subclass"], "ice_shelf"]
      ],
      "paint": {
        "fill-color": "#FFFAEB",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "landcover_glacier",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "maxzoom": 8,
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["MultiPolygon", "Polygon"],
          true,
          false
        ],
        ["==", ["get", "subclass"], "glacier"]
      ],
      "paint": {
        "fill-color": "#FFFAEB",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0,
          1,
          8,
          0.5
        ]
      }
    },
    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["MultiPolygon", "Polygon"],
          true,
          false
        ],
        ["==", ["get", "class"], "residential"]
      ],
      "paint": {
        "fill-color": "#EED8A7",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["MultiPolygon", "Polygon"],
          true,
          false
        ],
        ["==", ["get", "class"], "wood"]
      ],
      "paint": {
        "fill-color": "#B8C9A6",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "landuse_park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["MultiPolygon", "Polygon"],
          true,
          false
        ],
        ["==", ["get", "class"], "park"]
      ],
      "paint": {
        "fill-color": "#B8C9A6",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": [
        "match",
        ["geometry-type"],
        ["LineString", "MultiLineString"],
        true,
        false
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "miter"
      },
      "paint": {
        "line-color": "#bcc7b7",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          0.8,
          14,
          2.0
        ]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 12,
      "filter": [
        "match",
        ["geometry-type"],
        ["MultiPolygon", "Polygon"],
        true,
        false
      ],
      "paint": {
        "fill-antialias": true,
        "fill-color": "#F0B4A6",
        "fill-opacity": 0.95,
        "fill-outline-color": "#E3A394"
      }
    },
    {
      "id": "highway_path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        [
          "match",
          ["get", "class"],
          ["path", "track"],
          true,
          false
        ]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "miter"
      },
      "paint": {
        "line-color": "#e29161",
        "line-dasharray": [1, 2],
        "line-opacity": 0.7,
        "line-width": [
          "interpolate",
          ["exponential", 1.2],
          ["zoom"],
          12,
          0.8,
          20,
          3.5
        ]
      }
    },
    {
      "id": "highway_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        [
          "match",
          ["get", "class"],
          ["minor", "service", "raceway", "busway", "bus_guideway"],
          true,
          false
        ]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "miter"
      },
      "paint": {
        "line-color": "#e29161",
        "line-opacity": 0.85,
        "line-width": [
          "interpolate",
          ["exponential", 1.4],
          ["zoom"],
          10,
          0.6,
          12.5,
          1.5,
          20,
          14.0
        ]
      }
    },
    {
      "id": "highway_major_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        [
          "match",
          ["get", "class"],
          ["primary", "secondary", "tertiary", "trunk"],
          true,
          false
        ]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "miter"
      },
      "paint": {
        "line-color": "#e29161",
        "line-width": [
          "interpolate",
          ["exponential", 1.3],
          ["zoom"],
          8,
          1.8,
          12.5,
          3.6,
          20,
          18.0
        ]
      }
    },
    {
      "id": "highway_major_inner",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        [
          "match",
          ["get", "class"],
          ["primary", "secondary", "tertiary", "trunk"],
          true,
          false
        ]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "miter"
      },
      "paint": {
        "line-color": "#e29161",
        "line-width": [
          "interpolate",
          ["exponential", 1.3],
          ["zoom"],
          8,
          0.8,
          12.5,
          2.0,
          20,
          14.0
        ]
      }
    },
    {
      "id": "highway_motorway_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        ["==", ["get", "class"], "motorway"]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "miter"
      },
      "paint": {
        "line-color": "#e29161",
        "line-width": [
          "interpolate",
          ["exponential", 1.4],
          ["zoom"],
          6,
          1.8,
          12.5,
          4.5,
          20,
          28.0
        ]
      }
    },
    {
      "id": "highway_motorway_inner",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        ["==", ["get", "class"], "motorway"]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "miter"
      },
      "paint": {
        "line-color": "#e29161",
        "line-width": [
          "interpolate",
          ["exponential", 1.4],
          ["zoom"],
          6,
          0.8,
          12.5,
          2.5,
          20,
          20.0
        ]
      }
    },
    {
      "id": "railway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        ["==", ["get", "class"], "rail"]
      ],
      "layout": {
        "line-join": "miter"
      },
      "paint": {
        "line-color": "#9E947F",
        "line-width": [
          "interpolate",
          ["exponential", 1.3],
          ["zoom"],
          8,
          1.0,
          12.5,
          2.0,
          20,
          4.5
        ]
      }
    },
    {
      "id": "railway_dashline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        ["==", ["get", "class"], "rail"]
      ],
      "layout": {
        "line-join": "miter"
      },
      "paint": {
        "line-color": "#ebd4a2",
        "line-dasharray": [2, 2],
        "line-width": [
          "interpolate",
          ["exponential", 1.3],
          ["zoom"],
          8,
          0.6,
          12.5,
          1.2,
          20,
          3.0
        ]
      }
    },
    {
      "id": "boundary_country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", ["get", "admin_level"], 2],
      "layout": {
        "line-cap": "butt",
        "line-join": "miter"
      },
      "paint": {
        "line-color": "#F0A391",
        "line-dasharray": [5, 2, 1, 2],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3,
          1.2,
          10,
          2.5
        ]
      }
    }
  ]
}
